    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "size": "node ./scripts/size-check.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "5 kB"
    }
  ],
