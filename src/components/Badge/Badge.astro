---
export interface Props {
  variant?: "solid" | "outline" | "soft" | "glow";
  color?: "primary" | "success" | "warning" | "danger" | "neutral";
  size?: "sm" | "md" | "lg";
  animation?: "none" | "pulse" | "shine";
  class?: string;
  [key: string]: any;
}

const {
  variant = "solid",
  color = "primary",
  size = "md",
  animation = "none",
  class: className = "",
  ...rest
} = Astro.props;
---

<span
  class:list={["astro-badge", className]}
  data-astro-badge
  data-variant={variant}
  data-color={color}
  data-size={size}
  data-animation={animation}
  {...rest}
>
  <slot />
</span>

<style>
  [data-astro-badge] {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    border-radius: 9999px;
    font-weight: 600;
    pointer-events: none;
    position: relative;
    overflow: hidden;
    transition: all 0.2s ease-out;
    box-sizing: border-box;
    font-family: inherit;
  }

  [data-astro-badge][data-size="sm"] {
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    line-height: 1rem;
  }

  [data-astro-badge][data-size="md"] {
    font-size: 0.875rem;
    padding: 0.25rem 0.75rem;
    line-height: 1.25rem;
  }

  [data-astro-badge][data-size="lg"] {
    font-size: 1rem;
    padding: 0.375rem 1rem;
    line-height: 1.5rem;
  }

  [data-astro-badge][data-color="primary"] {
    --badge-color: 59, 130, 246;
  }

  [data-astro-badge][data-color="success"] {
    --badge-color: 34, 197, 94;
  }

  [data-astro-badge][data-color="warning"] {
    --badge-color: 245, 158, 11;
  }

  [data-astro-badge][data-color="danger"] {
    --badge-color: 239, 68, 68;
  }

  [data-astro-badge][data-color="neutral"] {
    --badge-color: 107, 114, 128;
  }

  [data-astro-badge][data-variant="solid"] {
    background-color: rgb(var(--badge-color));
    color: white;
    border: 1px solid rgb(var(--badge-color));
  }

  [data-astro-badge][data-variant="outline"] {
    background-color: transparent;
    color: rgb(var(--badge-color));
    border: 1px solid rgb(var(--badge-color));
  }

  [data-astro-badge][data-variant="soft"] {
    background-color: rgba(var(--badge-color), 0.15);
    color: rgb(var(--badge-color));
    border: 1px solid transparent;
  }

  [data-astro-badge][data-variant="glow"] {
    background-color: rgb(var(--badge-color));
    color: white;
    border: 1px solid rgb(var(--badge-color));
    box-shadow: 0 0 12px rgba(var(--badge-color), 0.6);
  }

  @keyframes badgePulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(var(--badge-color), 0.7);
    }

    70% {
      transform: scale(1.05);
      box-shadow: 0 0 0 6px rgba(var(--badge-color), 0);
    }

    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(var(--badge-color), 0);
    }
  }

  @keyframes badgeShine {
    0% {
      transform: translateX(-100%);
    }

    100% {
      transform: translateX(200%);
    }
  }

  [data-astro-badge][data-animation="pulse"] {
    animation: badgePulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
  }

  [data-astro-badge][data-animation="shine"]::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.4) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: translateX(-100%);
    animation: badgeShine 3s infinite cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-astro-badge],
    [data-astro-badge]::after {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      box-shadow: none !important;
    }

    [data-astro-badge][data-variant="glow"] {
      border: 1px solid rgb(var(--badge-color));
    }
  }
</style>
