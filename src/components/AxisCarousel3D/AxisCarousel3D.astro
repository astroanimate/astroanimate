---
import type { HTMLAttributes } from "astro/types";

interface AxisCarousel3DItem {
  image: string;
  title: string;
  description: string;
}

interface Props extends HTMLAttributes<"div"> {
  items?: AxisCarousel3DItem[];
  enhance?: boolean;
  autoRotateInterval?: number;
}

const {
  items = [
    {
      image:
        "https://images.unsplash.com/photo-1614850523296-d8c1af93d400?auto=format&fit=crop&q=80&w=800",
      title: "Atmospheric Depth",
      description: "Experience spatial interfaces with real-time perspective.",
    },
    {
      image:
        "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?auto=format&fit=crop&q=80&w=800",
      title: "Luminous Gradients",
      description: "Shift between ethereal color spaces and light states.",
    },
    {
      image:
        "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800",
      title: "Interactive Flow",
      description: "Fluid motion paths designed for complex UX systems.",
    },
    {
      image:
        "https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&q=80&w=800",
      title: "Cyber Architecture",
      description: "Digital structures built with neon-infused precision.",
    },
    {
      image:
        "https://images.unsplash.com/photo-1604076913837-52ab5629fba9?auto=format&fit=crop&q=80&w=800",
      title: "Organic Motion",
      description: "Soft, nature-inspired animations for soft interfaces.",
    },
  ],
  enhance = false,
  autoRotateInterval = 5000,
  class: className = "",
  style: styleProp,
  ...rest
} = Astro.props as Props;

const count = items.length;
const safeCount = Math.max(count, 1);
const radius =
  count > 1
    ? Math.max(180, Math.round(220 / Math.tan(Math.PI / count)))
    : 0;
const rootStyles = [
  `--axis-carousel-count: ${safeCount};`,
  `--axis-carousel-radius: ${radius}px;`,
  `--axis-carousel-current: 0;`,
  typeof styleProp === "string" ? styleProp : "",
]
  .filter(Boolean)
  .join(" ");
---

<style>
  [data-astro-axis-carousel-3d] {
    position: relative;
    width: min(100%, 72rem);
    min-height: clamp(28rem, 60vw, 38rem);
    margin-inline: auto;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    perspective: 2000px;
  }

  .astro-axis-carousel__viewport {
    width: 100%;
    min-height: inherit;
    display: grid;
    place-items: center;
    overflow: visible;
    transform-style: preserve-3d;
  }

  .astro-axis-carousel__scene {
    position: relative;
    width: min(100%, 25rem);
    aspect-ratio: 4 / 5;
    transform-style: preserve-3d;
    transform:
      translateZ(calc(var(--axis-carousel-radius) * -1))
      rotateY(calc(var(--axis-carousel-current) * (-360deg / var(--axis-carousel-count))));
    transition: transform 800ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .astro-axis-carousel__item {
    position: absolute;
    inset: 0;
    display: block;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    transform:
      rotateY(var(--axis-carousel-item-angle))
      translateZ(var(--axis-carousel-radius));
  }

  .astro-axis-carousel__card {
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: 2rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(15, 23, 42, 0.92));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 32px 80px rgba(15, 23, 42, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(10px);
  }

  .astro-axis-carousel__image-wrap {
    position: relative;
    flex: 1 1 auto;
    min-height: 70%;
    overflow: hidden;
  }

  .astro-axis-carousel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms ease;
  }

  .astro-axis-carousel__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.05) 10%, rgba(15, 23, 42, 0.8) 100%);
  }

  .astro-axis-carousel__content {
    padding: 1.5rem;
    color: #f8fafc;
  }

  .astro-axis-carousel__title {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .astro-axis-carousel__description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(226, 232, 240, 0.76);
  }

  .astro-axis-carousel__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .astro-axis-carousel__button {
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(15, 23, 42, 0.65);
    color: #f8fafc;
    cursor: pointer;
    transition:
      transform 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .astro-axis-carousel__button:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.6);
    background: rgba(30, 41, 59, 0.9);
  }

  .astro-axis-carousel__button:focus-visible {
    outline: 3px solid #38bdf8;
    outline-offset: 3px;
  }

  [data-astro-axis-carousel-3d][data-ready="true"] .astro-axis-carousel__item[data-active="true"] {
    z-index: 2;
  }

  [data-astro-axis-carousel-3d][data-ready="true"] .astro-axis-carousel__item[data-active="true"] .astro-axis-carousel__card {
    box-shadow:
      0 40px 100px rgba(15, 23, 42, 0.42),
      0 0 0 1px rgba(125, 211, 252, 0.14);
  }

  [data-astro-axis-carousel-3d][data-ready="true"] .astro-axis-carousel__item[data-active="true"] .astro-axis-carousel__image {
    transform: scale(1.03);
  }

  @media (max-width: 640px) {
    [data-astro-axis-carousel-3d] {
      min-height: 32rem;
    }

    .astro-axis-carousel__scene {
      width: min(100%, 18rem);
    }

    .astro-axis-carousel__content {
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .astro-axis-carousel__scene,
    .astro-axis-carousel__button,
    .astro-axis-carousel__image {
      transition: none !important;
      transform: none;
    }

    .astro-axis-carousel__item {
      transform:
        rotateY(var(--axis-carousel-item-angle))
        translateZ(var(--axis-carousel-radius));
    }
  }
</style>

<div
  class:list={["astro-axis-carousel-3d", className]}
  data-astro-axis-carousel-3d
  data-enhance={enhance ? "true" : "false"}
  data-count={count}
  data-current="0"
  data-interval={autoRotateInterval}
  style={rootStyles}
  {...rest}
>
  <div class="astro-axis-carousel__viewport">
    <div class="astro-axis-carousel__scene">
      {items.map((item, index) => (
        <article
          class="astro-axis-carousel__item"
          style={`--axis-carousel-item-angle: ${(360 / safeCount) * index}deg;`}
          data-index={index}
          data-active={index === 0 ? "true" : "false"}
          aria-hidden={index === 0 ? "false" : "true"}
        >
          <div class="astro-axis-carousel__card">
            <div class="astro-axis-carousel__image-wrap">
              <img
                class="astro-axis-carousel__image"
                src={item.image}
                alt={item.title}
                loading="lazy"
              />
              <div class="astro-axis-carousel__overlay"></div>
            </div>
            <div class="astro-axis-carousel__content">
              <h3 class="astro-axis-carousel__title">{item.title}</h3>
              <p class="astro-axis-carousel__description">{item.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  {count > 1 && (
    <div class="astro-axis-carousel__controls" aria-label="Carousel controls">
      <button
        class="astro-axis-carousel__button"
        type="button"
        data-axis-carousel-prev
        aria-label="Previous slide"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="astro-axis-carousel__button"
        type="button"
        data-axis-carousel-next
        aria-label="Next slide"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  )}
</div>

{enhance && (
  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      var store = window.__astroanimateAxisCarousel3D;
      if (!store) {
        store = {
          initialized: new WeakSet(),
        };
        window.__astroanimateAxisCarousel3D = store;
      }

      function enhanceAxisCarousel(root) {
        if (!(root instanceof HTMLElement)) return;
        if (store.initialized.has(root)) return;

        var count = Number(root.dataset.count || "0");
        if (count <= 1) return;

        var items = Array.from(root.querySelectorAll(".astro-axis-carousel__item"));
        var prevButton = root.querySelector("[data-axis-carousel-prev]");
        var nextButton = root.querySelector("[data-axis-carousel-next]");
        if (!(prevButton instanceof HTMLButtonElement) || !(nextButton instanceof HTMLButtonElement)) return;

        var current = Number(root.dataset.current || "0");
        var intervalMs = Number(root.dataset.interval || "5000");
        var timer = 0;

        function sync() {
          root.dataset.ready = "true";
          root.dataset.current = String(current);
          root.style.setProperty("--axis-carousel-current", String(current));

          items.forEach(function (item, index) {
            var isActive = index === current;
            item.setAttribute("data-active", isActive ? "true" : "false");
            item.setAttribute("aria-hidden", isActive ? "false" : "true");
          });
        }

        function stopAutoRotate() {
          if (timer) {
            window.clearInterval(timer);
            timer = 0;
          }
        }

        function startAutoRotate() {
          stopAutoRotate();
          timer = window.setInterval(function () {
            rotate(1);
          }, intervalMs);
        }

        function rotate(step) {
          current = (current + step + count) % count;
          sync();
        }

        prevButton.addEventListener("click", function () {
          rotate(-1);
          startAutoRotate();
        });

        nextButton.addEventListener("click", function () {
          rotate(1);
          startAutoRotate();
        });

        root.addEventListener("mouseenter", stopAutoRotate);
        root.addEventListener("mouseleave", startAutoRotate);
        root.addEventListener("focusin", stopAutoRotate);
        root.addEventListener("focusout", startAutoRotate);

        sync();
        startAutoRotate();
        store.initialized.add(root);

        var cleanupObserver = new MutationObserver(function () {
          if (!document.contains(root)) {
            stopAutoRotate();
            cleanupObserver.disconnect();
            store.initialized.delete(root);
          }
        });

        cleanupObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });
      }

      document
        .querySelectorAll('[data-astro-axis-carousel-3d][data-enhance="true"]:not([data-ready])')
        .forEach(function (element) {
          enhanceAxisCarousel(element);
        });
    })();
  </script>
)}
