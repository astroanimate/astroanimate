---
interface Props {
  text: string;
  speed?: number;
  class?: string;
  mainClassName?: string;
}

const {
  text,
  speed = 4,
  class: className = "",
  mainClassName = "",
} = Astro.props as Props;
---

<div
  class:list={["astro-breathing-text", className || mainClassName]}
  data-astro-breathing-text
  style={`--breathing-text-speed: ${speed}s;`}
>
  {text}
</div>

<style>
  [data-astro-breathing-text] {
    display: inline-block;
    opacity: 1;
    transform: none;
    letter-spacing: normal;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-astro-breathing-text] {
      animation: astro-breathing-text var(--breathing-text-speed) ease-in-out
        infinite alternate;
    }
  }

  @keyframes astro-breathing-text {
    0% {
      transform: scale(0.98);
      opacity: 0.7;
      letter-spacing: -0.01em;
    }

    100% {
      transform: scale(1.02);
      opacity: 1;
      letter-spacing: 0.02em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-astro-breathing-text] {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      letter-spacing: normal !important;
    }
  }
</style>
