---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  isGroup?: boolean;
  overlap?: string;
  src?: string;
  alt?: string;
  initials?: string;
  size?: "sm" | "md" | "lg" | "xl" | string;
  tooltip?: string;
  fallbackBg?: string;
}

const {
  isGroup = false,
  overlap = "-16px",
  src,
  alt = "",
  initials,
  size = "md",
  tooltip,
  fallbackBg = "var(--color-surface-muted, #333)",
  class: className = "",
  style: styleProp,
  ...rest
} = Astro.props as Props;

const sizeMap: Record<string, string> = {
  sm: "32px",
  md: "48px",
  lg: "64px",
  xl: "80px",
};

const calculatedSize = sizeMap[size] || size;
const derivedInitials = initials || (alt ? alt.charAt(0).toUpperCase() : "?");

const groupStyles = [
  `--avatar-overlap: ${overlap};`,
  typeof styleProp === "string" ? styleProp : "",
]
  .filter(Boolean)
  .join(" ");

const avatarStyles = [
  `--avatar-size: ${calculatedSize};`,
  `--avatar-bg: ${fallbackBg};`,
  typeof styleProp === "string" ? styleProp : "",
]
  .filter(Boolean)
  .join(" ");
---

{
  isGroup ? (
    <div
      class:list={["astro-avatar-group", className]}
      data-astro-avatar-group
      style={groupStyles}
      {...rest}
    >
      <slot />
    </div>
  ) : (
    <div
      class:list={["astro-avatar", className]}
      data-astro-avatar
      style={avatarStyles}
      {...rest}
    >
      <div class="astro-avatar__circle">
        {src ? (
          <img src={src} alt={alt} class="astro-avatar__image" />
        ) : (
          <span class="astro-avatar__fallback" aria-hidden={alt ? "true" : undefined}>
            {derivedInitials}
          </span>
        )}
      </div>

      {tooltip && (
        <div class="astro-avatar__tooltip" role="tooltip">
          {tooltip}
        </div>
      )}
    </div>
  )
}

<style>
  [data-astro-avatar-group] {
    display: flex;
    align-items: center;
    padding: 20px 0;
  }

  [data-astro-avatar-group] > * {
    margin-left: var(--avatar-overlap);
    position: relative;
    z-index: 1;
  }

  [data-astro-avatar-group] > *:first-child {
    margin-left: 0;
  }

  [data-astro-avatar-group] > *:hover {
    z-index: 50;
  }

  [data-astro-avatar] {
    position: relative;
    display: inline-flex;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .astro-avatar__circle {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 50%;
    border: 3px solid var(--color-background, #111);
    overflow: hidden;
    background: var(--avatar-bg);
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    color: white;
    font-weight: 600;
  }

  .astro-avatar__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .astro-avatar__fallback {
    font-size: calc(var(--avatar-size) * 0.4);
    text-transform: uppercase;
  }

  .astro-avatar__tooltip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #18181b;
    border: 1px solid #333;
    color: white;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5);
  }

  .astro-avatar__tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px;
    border-style: solid;
    border-color: #18181b transparent transparent transparent;
  }

  [data-astro-avatar]:hover {
    transform: translateY(-12px) scale(1.05);
    z-index: 10;
  }

  [data-astro-avatar]:hover .astro-avatar__tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-astro-avatar],
    .astro-avatar__tooltip {
      transition: none !important;
      transform: none !important;
    }

    [data-astro-avatar]:hover .astro-avatar__tooltip {
      transform: translateX(-50%) !important;
    }

    [data-astro-avatar]:hover {
      transform: none !important;
    }
  }
</style>
