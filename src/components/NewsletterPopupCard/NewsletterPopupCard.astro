---
interface Props {
  title?: string;
  description?: string;
  submitLabel?: string;
  class?: string;
  actionUrl?: string;
}

const {
  title = "Subscribe for updates",
  description =
    "Subscribe to this weekly newsletter so you don’t miss out on the latest tech topics.",
  submitLabel = "Subscribe",
  actionUrl = "/api/subscribe",
  class: className = "",
} = Astro.props;

const formId = `newsletter-form-${Math.random().toString(36).slice(2, 10)}`;
---

<style>
  /* ✅ CRITERION 7: CSS-FIRST */

  [data-npc],
  [data-npc] * {
    box-sizing: border-box;
  }

  [data-npc] {
    width: min(20rem, 100%);

    border: 1px solid #eeeeee;
    border-radius: 1rem;

    background: #ffffff;

    box-shadow:
      0 10px 30px rgba(0, 0, 0, 0.08);

    overflow: hidden;

    font-family:
      Inter,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;

    padding: 1.5rem;
  }

  .icon-box {
    width: 3.75rem;
    height: 3.75rem;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 0.75rem;

    background: #ecf1fd;

    box-shadow:
      0 1px 2px rgba(0,0,0,0.04);
  }

  .icon {
    width: 2rem;
    height: 2rem;

    color: #115dfc;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .title {
    margin: 0;

    color: #2b2b2f;

    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .description {
    margin: 0;

    color: #5f5d6b;

    font-size: 0.875rem;
    line-height: 1.5;
  }

  .input {
    width: 100%;
    height: 2.9rem;

    padding-inline: 0.875rem;

    border: 1px solid #e5e5e5;
    border-radius: 0.6rem;

    background: #ffffff;

    font-size: 0.95rem;

    transition:
      border-color 200ms ease,
      box-shadow 200ms ease;
  }

  .input::placeholder {
    color: #6b7280;
  }

  .input:focus {
    outline: none;

    border-color: #115dfc;

    box-shadow:
      0 0 0 4px rgba(17, 93, 252, 0.1);
  }

  /* Autofill fix */
  .input:-webkit-autofill,
  .input:-webkit-autofill:hover,
  .input:-webkit-autofill:focus,
  .input:-webkit-autofill:active {
    -webkit-box-shadow:
      0 0 0 1000px #ffffff inset !important;

    -webkit-text-fill-color:
      #111827 !important;
  }

  .submit {
    width: 100%;
    height: 2.9rem;

    border: none;
    border-radius: 0.6rem;

    background:
      linear-gradient(
        180deg,
        #4480ff 0%,
        #115dfc 50%,
        #0550ed 100%
      );

    color: white;

    font-size: 0.95rem;
    font-weight: 600;

    cursor: pointer;

    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }

  .submit:hover {
    opacity: 0.96;
  }

  .submit:active {
    transform: scale(0.985);
  }

  /* Accessibility */
  .submit:focus-visible,
  .input:focus-visible {
    outline: 2px solid #115dfc;
    outline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ✅ CRITERION 6 */
  @media (prefers-reduced-motion: reduce) {
    [data-npc],
    [data-npc] * {
      transition: none !important;
      animation: none !important;
      transform: none !important;
    }
  }
</style>

<div
  data-npc
  class={className}
>
  <form
    id={formId}
    data-newsletter-form
    class="form"
    action={actionUrl}
    data-action={actionUrl}
    method="post"
  >
    <div
      class="icon-box"
      aria-hidden="true"
    >
      <svg
        class="icon"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 34 34"
      >
        <path
          stroke-linejoin="round"
          stroke-width="2.5"
          stroke="currentColor"
          d="M7.08385 9.91666L5.3572 11.0677C4.11945 11.8929 3.50056 12.3055 3.16517 12.9347C2.82977 13.564 2.83226 14.3035 2.83722 15.7825C2.84322 17.5631 2.85976 19.3774 2.90559 21.2133C3.01431 25.569 3.06868 27.7468 4.67008 29.3482C6.27148 30.9498 8.47873 31.0049 12.8932 31.1152C15.6396 31.1838 18.3616 31.1838 21.1078 31.1152C25.5224 31.0049 27.7296 30.9498 29.331 29.3482C30.9324 27.7468 30.9868 25.569 31.0954 21.2133C31.1413 19.3774 31.1578 17.5631 31.1639 15.7825C31.1688 14.3035 31.1712 13.564 30.8359 12.9347C30.5004 12.3055 29.8816 11.8929 28.6437 11.0677L26.9171 9.91666"
        />

        <path
          stroke-linejoin="round"
          stroke-width="2.5"
          stroke="currentColor"
          d="M2.83331 14.1667L12.6268 20.0427C14.7574 21.3211 15.8227 21.9603 17 21.9603C18.1772 21.9603 19.2426 21.3211 21.3732 20.0427L31.1666 14.1667"
        />

        <path
          stroke-width="2.5"
          stroke="currentColor"
          d="M7.08331 17V8.50001C7.08331 5.82872 7.08331 4.49307 7.91318 3.66321C8.74304 2.83334 10.0787 2.83334 12.75 2.83334H21.25C23.9212 2.83334 25.2569 2.83334 26.0868 3.66321C26.9166 4.49307 26.9166 5.82872 26.9166 8.50001V17"
        />

        <path
          stroke-linejoin="round"
          stroke-linecap="round"
          stroke-width="2.5"
          stroke="currentColor"
          d="M14.1667 14.1667H19.8334M14.1667 8.5H19.8334"
        />
      </svg>
    </div>

    <div class="content">
      <h2 class="title">
        {title}
      </h2>

      <p class="description">
        {description}
      </p>
    </div>

    <label class="sr-only" for={`${formId}-email`}>
      Email address
    </label>

    <input
      id={`${formId}-email`}
      class="input"
      type="email"
      name="email"
      autocomplete="email"
      placeholder="Enter your email"
      required
    />

    <button
      class="submit"
      type="submit"
    >
      {submitLabel}
    </button>
  </form>
</div>

<script is:inline>
  document.querySelectorAll("[data-newsletter-form]:not([data-newsletter-ready])").forEach((form) => {
    form.setAttribute("data-newsletter-ready", "true");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      
      const formData = new FormData(form);
      const email = formData.get("email");
      const url = form.dataset.action; 

      console.log(`Submitting ${email} to ${url}`);

      try {
        // Simulating API call for demonstration. Replace with actual fetch call.
        /*
        const response = await fetch(url, {
          method: "POST",
          body: JSON.stringify({ email }),
          headers: {
            "Content-Type": "application/json",
          },
        });
        */
        
        alert(`Thanks for subscribing with: ${email}\n(This would normally be sent to: ${url})`);
        form.reset();
      } catch (error) {
        console.error("Subscription failed:", error);
      }
    });
  });
</script>
