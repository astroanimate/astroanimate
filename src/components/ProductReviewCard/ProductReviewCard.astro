---
interface Props {
  title: string;
  description: string;
  rating?: number;
  reviews?: number;
  class?: string;
}

const {
  title,
  description,
  rating = 4.8,
  reviews = 24,
  class: className = "",
} = Astro.props;
---

<style>
  /* ✅ CRITERION 7: CSS-FIRST */

  [data-pgc] {
    position: relative;

    width: min(20rem, 100%);
    overflow: hidden;

    border: 1px solid #e5e7eb;
    border-radius: 1rem;

    background: white;
    color: #1f2937;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Arial,
      sans-serif;

    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;

    box-shadow:
      0 4px 10px rgba(0,0,0,0.06);

    transition:
      transform 500ms ease,
      box-shadow 500ms ease;
  }

  [data-pgc]:hover,
  [data-pgc]:focus-within {
    transform: scale(1.05);

    box-shadow:
      0 10px 25px rgba(0,0,0,0.12);
  }

  /* Glow layer */
  .glow {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        135deg,
        #f3f4f6,
        #ffffff
      );

    opacity: 0;

    filter: blur(12px);

    transition: opacity 500ms ease;
  }

  [data-pgc]:hover .glow,
  [data-pgc]:focus-within .glow {
    opacity: 0.3;
  }

  .content {
    position: relative;
    z-index: 1;

    padding: 1.5rem;
  }

  .title {
    margin: 0;

    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.03em;

    color: #1f2937;
  }

  .description {
    margin-top: 0.75rem;

    color: #4b5563;
    line-height: 1.6;

    font-size: 0.95rem;
    font-weight: 400;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;

    margin-top: 1rem;

    color: #4b5563;

    font-size: 0.9rem;
    font-weight: 500;
  }

  .star {
    width: 1.5rem;
    height: 1.5rem;

    color: #eab308;

    flex-shrink: 0;
  }

  /* Accessibility */
  [data-pgc]:focus-within {
    outline: 2px solid #1f2937;
    outline-offset: 4px;
  }

  /* ✅ CRITERION 6: REDUCED MOTION */
  @media (prefers-reduced-motion: reduce) {
    [data-pgc],
    [data-pgc] * {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<article
  data-pgc
  class={className}
>
  <div
    class="glow"
    aria-hidden="true"
  ></div>

  <div class="content">
    <p class="title">{title}</p>

    <p class="description">
      {description}
    </p>

    <div class="meta">
      <svg
        class="star"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M12 17.27L18.18 21l-1.64-7.03L22
          9.24l-7.19-.61L12 2 9.19 8.63
          2 9.24l5.46 4.73L5.82 21z"
        />
      </svg>

      <span>
        {rating} ({reviews} reviews)
      </span>
    </div>
  </div>
</article>