---
interface Props {
  title: string;
  rate: string;

  company?: string;
  buttonLabel?: string;

  /* NEW */
  companyLogo?: string;

  as?: "button" | "a";
  href?: string;

  class?: string;
}

const {
  title,
  rate,

  company = "Company",
  buttonLabel = "View",

  /* NEW */
  companyLogo,

  as = "button",
  href,
  class: className = "",
} = Astro.props;
---

<style>
  /* ✅ CRITERION 7: CSS-FIRST */

  [data-job-card] {
    width: min(320px, 100%);
    padding: 0.5rem;

    border: 1px solid #e5e5e5;
    border-radius: 1rem;

    background: #fefefe;
    color: #141417;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;

    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .hero {
    padding: 1.5rem;
    border-radius: 0.75rem 0.75rem 0 0;

    background: #fef4e2;
    font-size: 0.875rem;
  }

  .hero-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;

    font-weight: 700;
  }

  .title {
    margin: 2rem 0;
    padding-right: 2rem;

    font-size: 2rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    padding: 0.75rem;

    font-size: 0.875rem;
    font-weight: 700;
  }

  @media (min-width: 340px) {
    .footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .company {
    line-height: 1.2;
  }

  .btn {
    width: 100%;
    padding: 0.75rem 1.35rem;

    border: none;
    border-radius: 999px;

    background: #141417;
    color: white;

    font-size: 1rem;
    font-weight: 500;

    cursor: pointer;
    text-align: center;
    text-decoration: none;
    text-transform: lowercase;

    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .btn:hover {
    opacity: 0.92;
  }

  .btn:active {
    transform: scale(0.98);
  }

  @media (min-width: 340px) {
    .btn {
      width: max-content;
    }
  }

  .icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Accessibility */
  .btn:focus-visible {
    outline: 2px solid black;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none !important;
    }
    .btn:active {
      transform: none !important;
    }
  }
</style>

<article
  data-job-card
  class={className}
>
  <section class="hero">
    <header class="hero-header">
      <span>{rate}</span>
    </header>

    <p class="title">{title}</p>
  </section>

  <footer class="footer">
    <div class="summary">
      <div
        class="icon"
        aria-hidden="true"
      >
        {companyLogo && (
          companyLogo.trim().startsWith('<svg') ? (
            <Fragment set:html={companyLogo} />
          ) : (
            <img 
              src={companyLogo} 
              alt={`${company} logo`} 
              width="32" 
              height="32" 
              style="object-fit: contain; border-radius: 4px;" 
            />
          )
        )}
      </div>

      <div class="company">
        <p>{company}</p>
      </div>
    </div>

    {as === "a" ? (
      <a
        href={href}
        class="btn"
      >
        {buttonLabel}
      </a>
    ) : (
      <button
        type="button"
        class="btn"
      >
        {buttonLabel}
      </button>
    )}
  </footer>
</article>
