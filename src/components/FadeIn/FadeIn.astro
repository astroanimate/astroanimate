---
import type { HTMLAttributes } from "astro/types";

type FadeInTag =
  | "div"
  | "section"
  | "article"
  | "aside"
  | "main"
  | "header"
  | "footer"
  | "nav"
  | "span"
  | "p"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "li"
  | "ul"
  | "ol"
  | "a"
  | "button";

interface Props extends HTMLAttributes<"div"> {
  /**
   * Explicit opt-in to JS enhancement (Scroll Reveal).
   * If false, component renders visible immediately with no animation.
   * @default false
   */
  enhance?: boolean;

  /**
   * Direction of entrance animation.
   * @default "none" (just opacity)
   */
  direction?: "none" | "up" | "down" | "left" | "right";

  /**
   * Distance of travel in pixels (if direction is not "none").
   * @default 20
   */
  distance?: number;

  /**
   * Duration of animation in milliseconds.
   * @default 500
   */
  duration?: number;

  /**
   * Delay before animation starts in milliseconds.
   * @default 0
   */
  delay?: number;

  /**
   * CSS easing function.
   * @default "ease-out"
   */
  easing?: string;

  /**
   * Whether animation should only play once.
   * If false, it reverses when scrolling out.
   * @default true
   */
  once?: boolean;

  /**
   * Initial blur amount (e.g. "10px").
   * @default "0px"
   */
  blur?: string;

  /**
   * Class name for the root element.
   */
  class?: string;

  /**
   * Inline styles merged with the component CSS variables.
   */
  style?: string;

  /**
   * As: Element tag
   * @default "div"
   */
  as?: FadeInTag;

  /**
   * IntersectionObserver threshold.
   * @default 0.1
   */
  threshold?: number;

  /**
   * IntersectionObserver rootMargin.
   * @default "0px 0px -50px 0px"
   */
  rootMargin?: string;
}

const {
  enhance = false,
  direction = "none",
  distance = 20,
  duration = 500,
  delay = 0,
  easing = "ease-out",
  once = true,
  blur = "0px",
  class: className = "",
  style: styleProp,
  as: Tag = "div",
  threshold = 0.1,
  rootMargin = "0px 0px -50px 0px",
  ...rest
} = Astro.props as Props;

const clamp = (value: number, min: number, max: number) =>
  Math.min(Math.max(value, min), max);

const safeDistance = Number.isFinite(distance) ? Math.max(0, distance) : 20;
const safeDuration = Number.isFinite(duration) ? Math.max(0, duration) : 500;
const safeDelay = Number.isFinite(delay) ? Math.max(0, delay) : 0;
const safeThreshold = Number.isFinite(threshold) ? clamp(threshold, 0, 1) : 0.1;
const safeRootMargin = rootMargin.trim() || "0px 0px -50px 0px";

const getTransform = () => {
  switch (direction) {
    case "up":
      return `translateY(${safeDistance}px)`;
    case "down":
      return `translateY(-${safeDistance}px)`;
    case "left":
      return `translateX(${safeDistance}px)`;
    case "right":
      return `translateX(-${safeDistance}px)`;
    default:
      return "none";
  }
};

const initialTransform = getTransform();
const mergedStyles = [
  `--fade-duration: ${safeDuration}ms;`,
  `--fade-delay: ${safeDelay}ms;`,
  `--fade-easing: ${easing};`,
  `--fade-transform: ${initialTransform};`,
  `--fade-blur: ${blur};`,
  typeof styleProp === "string" ? styleProp : "",
]
  .filter(Boolean)
  .join(" ");
---

<style>
  [data-astro-fade-in] {
    opacity: 1;
    transform: none;
    filter: none;
  }

  [data-astro-fade-in][data-ready="true"] {
    transition:
      opacity var(--fade-duration) var(--fade-easing) var(--fade-delay),
      transform var(--fade-duration) var(--fade-easing) var(--fade-delay),
      filter var(--fade-duration) var(--fade-easing) var(--fade-delay);
    will-change: opacity, transform, filter;
  }

  [data-astro-fade-in][data-ready="true"][data-state="hidden"] {
    opacity: 0;
    transform: var(--fade-transform);
    filter: blur(var(--fade-blur));
  }

  [data-astro-fade-in][data-ready="true"][data-state="visible"] {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }

  @media (prefers-reduced-motion: reduce) {
    [data-astro-fade-in] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      filter: none !important;
    }
  }
</style>

<Tag
  class:list={["astro-fade-in", className]}
  data-astro-fade-in
  data-enhance={enhance ? "true" : "false"}
  data-once={once ? "true" : "false"}
  data-threshold={String(safeThreshold)}
  data-root-margin={safeRootMargin}
  style={mergedStyles}
  {...rest}
>
  <slot />
</Tag>

{enhance && (
  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      var initialized = new WeakMap();
      var selector = '[data-astro-fade-in][data-enhance="true"]:not([data-ready])';
      var bootstrapObserver = null;
      var managedRoots = 0;

      function parseThreshold(value) {
        var parsed = Number(value);
        if (!Number.isFinite(parsed)) return 0.1;
        return Math.min(Math.max(parsed, 0), 1);
      }

      function emitFadeInEvent(root, state) {
        root.dispatchEvent(
          new CustomEvent("astro:fadein:" + state, {
            bubbles: true,
            detail: {
              once: root.dataset.once === "true",
              enhance: root.dataset.enhance === "true",
            },
          })
        );
      }

      function maybeDisconnectBootstrapObserver() {
        if (managedRoots > 0 || !bootstrapObserver) return;
        bootstrapObserver.disconnect();
        bootstrapObserver = null;
      }

      function enhanceFadeIn(root) {
        if (!(root instanceof HTMLElement)) return;
        if (initialized.has(root)) return;

        root.dataset.state = "hidden";
        managedRoots += 1;
        emitFadeInEvent(root, "init");

        var isOnce = root.dataset.once === "true";
        var threshold = parseThreshold(root.dataset.threshold);
        var rootMargin = root.dataset.rootMargin && root.dataset.rootMargin.trim()
          ? root.dataset.rootMargin.trim()
          : "0px 0px -50px 0px";
        var cleanupObserver;
        var isCleanedUp = false;

        function cleanup() {
          if (isCleanedUp) return;
          isCleanedUp = true;
          observer.disconnect();
          if (cleanupObserver) cleanupObserver.disconnect();
          initialized.delete(root);
          managedRoots = Math.max(0, managedRoots - 1);
          maybeDisconnectBootstrapObserver();
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                root.dataset.state = "visible";
                emitFadeInEvent(root, "visible");
                if (isOnce) cleanup();
              } else if (!isOnce) {
                root.dataset.state = "hidden";
                emitFadeInEvent(root, "hidden");
              }
            });
          },
          {
            threshold: threshold,
            rootMargin: rootMargin,
          }
        );

        observer.observe(root);
        initialized.set(root, cleanup);

        cleanupObserver = new MutationObserver(function () {
          if (!document.contains(root)) cleanup();
        });

        cleanupObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });
      }

      function initElement(element) {
        if (!(element instanceof HTMLElement)) return;
        if (element.dataset.ready === "true") return;
        element.dataset.ready = "true";
        enhanceFadeIn(element);
      }

      function initFadeIns(root) {
        root.querySelectorAll(selector).forEach(initElement);
      }

      function ensureBootstrapObserver() {
        if (bootstrapObserver || typeof document === "undefined") return;

        bootstrapObserver = new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
              if (!(node instanceof Element)) return;
              if (node.matches(selector)) initElement(node);
              initFadeIns(node);
            });
          });
        });

        bootstrapObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });
      }

      ensureBootstrapObserver();
      initFadeIns(document);
    })();
  </script>
)}
