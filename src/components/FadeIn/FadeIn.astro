---
import type { HTMLAttributes } from "astro/types";

type FadeInTag =
  | "div"
  | "section"
  | "article"
  | "aside"
  | "main"
  | "header"
  | "footer"
  | "nav"
  | "span"
  | "p"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "li"
  | "ul"
  | "ol"
  | "a"
  | "button";

interface Props extends HTMLAttributes<"div"> {
  /**
   * Explicit opt-in to JS enhancement (Scroll Reveal).
   * If false, component renders visible immediately with no animation.
   * @default false
   */
  enhance?: boolean;

  /**
   * Direction of entrance animation.
   * @default "up"
   */
  direction?: "none" | "up" | "down" | "left" | "right";

  /**
   * Offset distance in pixels for the animation.
   * For vertical directions: animates from +offset to -offset.
   * For horizontal directions: animates from +offset to -offset.
   * @default 8
   */
  offset?: number;

  /**
   * Duration of animation in seconds.
   * @default 0.6
   */
  duration?: number;

  /**
   * Delay before animation starts in seconds.
   * @default 0
   */
  delay?: number;

  /**
   * CSS easing function.
   * @default "cubic-bezier(0.4, 0, 0.2, 1)"
   */
  easing?: string;

  /**
   * Whether animation should only play once.
   * If false, it reverses when scrolling out.
   * @default true
   */
  once?: boolean;

  /**
   * Initial blur amount (e.g. "4px").
   * @default "4px"
   */
  blur?: string;

  /**
   * Class name for the root element.
   */
  class?: string;

  /**
   * Inline styles merged with the component CSS variables.
   */
  style?: string;

  /**
   * As: Element tag
   * @default "div"
   */
  as?: FadeInTag;

  /**
   * IntersectionObserver threshold (0-1).
   * @default 0.1
   */
  threshold?: number;

  /**
   * IntersectionObserver rootMargin.
   * @default "-50px"
   */
  inViewMargin?: string;

  /**
   * Custom callback when element becomes visible.
   * Called after animation completes.
   */
  onVisible?: () => void;

  /**
   * Custom callback when element becomes hidden.
   * Called after reverse animation completes (if once=false).
   */
  onHidden?: () => void;

  /**
   * Custom CSS variable overrides for advanced customization.
   * Allows fine-tuning of animation properties.
   */
  customVars?: Record<string, string>;
}

const {
  enhance = false,
  direction = "up",
  offset = 8,
  duration = 0.6,
  delay = 0,
  easing = "cubic-bezier(0.4, 0, 0.2, 1)",
  once = true,
  blur = "4px",
  class: className = "",
  style: styleProp,
  as: Tag = "div",
  threshold = 0.1,
  inViewMargin = "-50px",
  onVisible,
  onHidden,
  customVars = {},
  ...rest
} = Astro.props as Props;

const clamp = (value: number, min: number, max: number) =>
  Math.min(Math.max(value, min), max);

const validDirections = ["none", "up", "down", "left", "right"] as const;
const safeDirection = validDirections.includes(direction as any)
  ? direction
  : "up";

const safeOffset = Number.isFinite(offset) ? Math.max(0, offset) : 8;
const safeDuration = Number.isFinite(duration) ? Math.max(0, duration) : 0.6;
const safeDelay = Number.isFinite(delay) ? Math.max(0, delay) : 0;
const safeThreshold = Number.isFinite(threshold) ? clamp(threshold, 0, 1) : 0.1;
const safeInViewMargin = inViewMargin.trim() || "-50px";

// Validate blur format (basic check for px, rem, em, etc.)
const blurValue = blur.trim();
const hasValidBlurUnit = /^(0|(\d+\.?\d*)(px|rem|em|vh|vw|%))$/.test(blurValue);
const safeBlur = hasValidBlurUnit && blurValue ? blurValue : "4px";

// Calculate transform based on direction (from +offset to -offset pattern)
const getTransform = (isInitial: boolean) => {
  const sign = isInitial ? 1 : -1;
  switch (safeDirection) {
    case "up":
      return `translateY(${sign * safeOffset}px)`;
    case "down":
      return `translateY(${sign * -safeOffset}px)`;
    case "left":
      return `translateX(${sign * safeOffset}px)`;
    case "right":
      return `translateX(${sign * -safeOffset}px)`;
    default:
      return "none";
  }
};

const initialTransform = getTransform(true);
const finalTransform = getTransform(false);

// Build custom CSS variables from customVars prop
const customVarStyles = Object.entries(customVars)
  .map(([key, value]) => `--${key}: ${value};`)
  .join(" ");

const mergedStyles = [
  `--fade-duration: ${safeDuration}s;`,
  `--fade-delay: ${safeDelay}s;`,
  `--fade-easing: ${easing};`,
  `--fade-transform-initial: ${initialTransform};`,
  `--fade-transform-final: ${finalTransform};`,
  `--fade-blur: ${safeBlur};`,
  customVarStyles,
  typeof styleProp === "string" ? styleProp : "",
]
  .filter(Boolean)
  .join(" ");
---

<style>
  /* 
   * 🟢 NO-JS / DEFAULT STATE 
   * Visible immediately. No transitions.
   */
  [data-astro-fade-in] {
    opacity: 1;
    transform: none;
    filter: none;
  }

  [data-astro-fade-in][data-ready="true"] {
    transition:
      opacity var(--fade-duration) var(--fade-easing) var(--fade-delay),
      transform var(--fade-duration) var(--fade-easing) var(--fade-delay),
      filter var(--fade-duration) var(--fade-easing) var(--fade-delay);
    will-change: opacity, transform, filter;
  }

  /* 
   * 🟡 ENHANCER INITIALIZATION 
   * JS adds [data-ready="true"] to signal it's taking control.
   * We hide it immediately to prepare for entry.
   */
  [data-astro-fade-in][data-ready="true"][data-state="hidden"] {
    opacity: 0;
    transform: var(--fade-transform-initial);
    filter: blur(var(--fade-blur));
  }

  /* 
   * 🟢 VISIBLE STATE 
   * Applied when element enters viewport.
   */
  [data-astro-fade-in][data-ready="true"][data-state="visible"] {
    opacity: 1;
    transform: var(--fade-transform-final);
    filter: blur(0);
  }

  /* 
   * ♿ REDUCED MOTION 
   * Force visibility and disable transitions regardless of JS state.
   */
  @media (prefers-reduced-motion: reduce) {
    [data-astro-fade-in] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
      filter: none !important;
    }
  }
</style>

<Tag
  class:list={["astro-fade-in", className]}
  data-astro-fade-in
  data-enhance={enhance ? "true" : "false"}
  data-once={once ? "true" : "false"}
  data-threshold={String(safeThreshold)}
  data-in-view-margin={safeInViewMargin}
  data-on-visible={onVisible ? "true" : "false"}
  data-on-hidden={onHidden ? "true" : "false"}
  style={mergedStyles}
  {...rest}
>
  <slot />
</Tag>

{enhance && (
  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      var initialized = new WeakMap();
      var selector = '[data-astro-fade-in][data-enhance="true"]:not([data-ready])';
      var bootstrapObserver = null;
      var managedRoots = 0;

      function parseThreshold(value) {
        var parsed = Number(value);
        if (!Number.isFinite(parsed)) return 0.1;
        return Math.min(Math.max(parsed, 0), 1);
      }

      function emitFadeInEvent(root, state) {
        root.dispatchEvent(
          new CustomEvent("astro:fadein:" + state, {
            bubbles: true,
            detail: {
              once: root.dataset.once === "true",
              enhance: root.dataset.enhance === "true",
            },
          })
        );
      }

      function maybeDisconnectBootstrapObserver() {
        if (managedRoots > 0 || !bootstrapObserver) return;
        bootstrapObserver.disconnect();
        bootstrapObserver = null;
      }

      function enhanceFadeIn(root) {
        if (!(root instanceof HTMLElement)) return;
        if (initialized.has(root)) return;

        root.dataset.state = "hidden";
        managedRoots += 1;
        emitFadeInEvent(root, "init");

        var isOnce = root.dataset.once === "true";
        var threshold = parseThreshold(root.dataset.threshold);
        var rootMargin = root.dataset.inViewMargin && root.dataset.inViewMargin.trim()
          ? root.dataset.inViewMargin.trim()
          : "-50px";
        var hasOnVisible = root.dataset.onVisible === "true";
        var hasOnHidden = root.dataset.onHidden === "true";
        var cleanupObserver;
        var isCleanedUp = false;

        function cleanup() {
          if (isCleanedUp) return;
          isCleanedUp = true;
          observer.disconnect();
          if (cleanupObserver) cleanupObserver.disconnect();
          initialized.delete(root);
          managedRoots = Math.max(0, managedRoots - 1);
          maybeDisconnectBootstrapObserver();
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                root.dataset.state = "visible";
                emitFadeInEvent(root, "visible");

                // Call onVisible callback after animation completes
                if (hasOnVisible) {
                  var duration =
                    parseFloat(
                      getComputedStyle(root).getPropertyValue("--fade-duration") ||
                        "0.4"
                    ) * 1000;
                  var delay =
                    parseFloat(
                      getComputedStyle(root).getPropertyValue("--fade-delay") || "0"
                    ) * 1000;
                  setTimeout(function () {
                    root.dispatchEvent(
                      new CustomEvent("astro:fadein:callback-visible", {
                        bubbles: true,
                      })
                    );
                  }, duration + delay);
                }

                if (isOnce) cleanup();
              } else if (!isOnce) {
                // If not 'once', we hide it again when it leaves viewport
                // to allow re-playing the animation
                root.dataset.state = "hidden";
                emitFadeInEvent(root, "hidden");

                // Call onHidden callback after animation completes
                if (hasOnHidden) {
                  var duration =
                    parseFloat(
                      getComputedStyle(root).getPropertyValue("--fade-duration") ||
                        "0.4"
                    ) * 1000;
                  var delay =
                    parseFloat(
                      getComputedStyle(root).getPropertyValue("--fade-delay") || "0"
                    ) * 1000;
                  setTimeout(function () {
                    root.dispatchEvent(
                      new CustomEvent("astro:fadein:callback-hidden", {
                        bubbles: true,
                      })
                    );
                  }, duration + delay);
                }
              }
            });
          },
          {
            threshold: threshold,
            rootMargin: rootMargin,
          }
        );

        observer.observe(root);
        initialized.set(root, cleanup);

        cleanupObserver = new MutationObserver(function () {
          if (!document.contains(root)) cleanup();
        });

        cleanupObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });
      }

      function initElement(element) {
        if (!(element instanceof HTMLElement)) return;
        if (element.dataset.ready === "true") return;
        element.dataset.ready = "true";
        enhanceFadeIn(element);
      }

      function initFadeIns(root) {
        root.querySelectorAll(selector).forEach(initElement);
      }

      function ensureBootstrapObserver() {
        if (bootstrapObserver || typeof document === "undefined") return;

        bootstrapObserver = new MutationObserver(function (mutations) {
          mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
              if (!(node instanceof Element)) return;
              if (node.matches(selector)) initElement(node);
              initFadeIns(node);
            });
          });
        });

        bootstrapObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });
      }

      ensureBootstrapObserver();
      initFadeIns(document);
    })();
  </script>
)}
