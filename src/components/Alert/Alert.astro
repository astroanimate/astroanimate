---
interface Props {
  variant?: "info" | "success" | "warning" | "error";
  dismissible?: boolean;
  class?: string;
}

const {
  variant = "info",
  dismissible = false,
  class: className = "",
} = Astro.props as Props;
---

<style>
  [data-astro-alert] {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 8px;
    font-family: system-ui, sans-serif;
    opacity: 1;
    transform: none;
  }

  [data-astro-alert][data-variant="info"] {
    background: #e0f2fe;
    color: #0284c7;
  }

  [data-astro-alert][data-variant="success"] {
    background: #dcfce7;
    color: #166534;
  }

  [data-astro-alert][data-variant="warning"] {
    background: #fef08a;
    color: #854d0e;
  }

  [data-astro-alert][data-variant="error"] {
    background: #fee2e2;
    color: #991b1b;
  }

  [data-astro-alert][data-state="visible"] {
    opacity: 1;
    display: flex;
  }

  [data-astro-alert][data-state="dismissed"] {
    opacity: 0;
    transform: translateY(-10px);
    pointer-events: none;
  }

  .astro-alert__content {
    flex: 1 1 auto;
  }

  .astro-alert__dismiss {
    appearance: none;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
    flex: 0 0 auto;
    opacity: 0.6;
    padding: 0.5rem;
  }

  .astro-alert__dismiss:hover {
    opacity: 1;
  }

  [data-astro-alert][data-ready="true"] {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-astro-alert] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    [data-astro-alert][data-state="dismissed"] {
      display: none !important;
    }
  }
</style>

<div
  class:list={["astro-alert", className]}
  role="alert"
  data-astro-alert
  data-variant={variant}
  data-dismissible={dismissible ? "true" : "false"}
>
  <div class="astro-alert__content">
    <slot />
  </div>

  {dismissible && (
    <button
      type="button"
      class="astro-alert__dismiss"
      aria-label="Dismiss alert"
      data-dismiss-target
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M1 1L13 13M1 13L13 1" />
      </svg>
    </button>
  )}
</div>

{dismissible && (
  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;

      var initialized = new WeakMap();

      function bindDismiss(root) {
        if (!(root instanceof HTMLElement)) return;
        if (initialized.has(root)) return;

        var button = root.querySelector("[data-dismiss-target]");
        if (!(button instanceof HTMLElement)) return;

        root.dataset.ready = "true";

        var cleanupObserver;
        var handler = function () {
          root.dataset.state = "dismissed";
          if (cleanupObserver) cleanupObserver.disconnect();
          initialized.delete(root);
        };

        button.addEventListener("click", handler, { once: true });

        cleanupObserver = new MutationObserver(function () {
          if (!document.contains(root)) {
            button.removeEventListener("click", handler);
            cleanupObserver.disconnect();
            initialized.delete(root);
          }
        });

        cleanupObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });

        initialized.set(root, function () {
          button.removeEventListener("click", handler);
          cleanupObserver.disconnect();
        });
      }

      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      document
        .querySelectorAll('[data-astro-alert][data-dismissible="true"]:not([data-ready])')
        .forEach(function (element) {
          if (!(element instanceof HTMLElement)) return;

          if (reduceMotion) {
            bindDismiss(element);
            return;
          }

          bindDismiss(element);
        });
    })();
  </script>
)}
