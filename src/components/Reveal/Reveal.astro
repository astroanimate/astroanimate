---
interface Props {
  enhance?: boolean;
  effect?: "fade" | "slide-up";
  delay?: number;
  once?: boolean;
  class?: string;
}

const {
  enhance = false,
  effect = "fade",
  delay = 0,
  once = true,
  class: className = "",
} = Astro.props as Props;
---

<style>
  [data-astro-reveal] {
    opacity: 1;
    transform: none;
    transition:
      opacity 600ms ease-out var(--reveal-delay),
      transform 600ms ease-out var(--reveal-delay);
  }

  [data-astro-reveal][data-ready="true"][data-state="hidden"] {
    opacity: 0;
    transform: translateY(20px);
  }

  [data-astro-reveal][data-effect="fade"][data-ready="true"][data-state="hidden"] {
    transform: none;
  }

  [data-astro-reveal][data-ready="true"][data-state="visible"] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-astro-reveal] {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<div
  class:list={["astro-reveal", className]}
  data-astro-reveal
  data-enhance={enhance ? "true" : "false"}
  data-effect={effect}
  data-once={String(once)}
  style={`--reveal-delay: ${delay}ms;`}
>
  <slot />
</div>

{enhance && (
  <script is:inline>
    (function () {
      if (typeof window === "undefined") return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      var initialized = new WeakMap();

      function enhanceReveal(root) {
        if (!(root instanceof HTMLElement)) return;
        if (initialized.has(root)) return;

        root.dataset.ready = "true";
        root.dataset.state = "hidden";

        var isOnce = root.dataset.once === "true";
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.target !== root) return;

              if (entry.isIntersecting) {
                root.dataset.state = "visible";

                if (isOnce) {
                  observer.unobserve(root);
                  observer.disconnect();
                  cleanupObserver.disconnect();
                  initialized.delete(root);
                }
              } else if (!isOnce) {
                root.dataset.state = "hidden";
              }
            });
          },
          { threshold: 0.15 }
        );

        observer.observe(root);

        var cleanupObserver = new MutationObserver(function () {
          if (!document.contains(root)) {
            observer.disconnect();
            cleanupObserver.disconnect();
            initialized.delete(root);
          }
        });

        cleanupObserver.observe(document.body, {
          childList: true,
          subtree: true,
        });

        initialized.set(root, {
          observer: observer,
          cleanupObserver: cleanupObserver,
        });
      }

      document
        .querySelectorAll('[data-astro-reveal][data-enhance="true"]:not([data-ready])')
        .forEach(function (element) {
          enhanceReveal(element);
        });
    })();
  </script>
)}
